---
import { AMAZON_DISCLOSURE, AFFILIATE_REL, AFFILIATE_TARGET } from '../config/affiliate';
import type { ShopGroup, ShopLink } from '../lib/shop';
interface Props { groups: ShopGroup[]; title?: string; flagged?: boolean; lead?: string; anchor?: boolean; compact?: boolean; }
const { groups, title = 'Shop for matching parts & gear on Amazon', flagged = false, lead, anchor = false, compact = false } = Astro.props;
const visible = (compact ? groups.filter((g) => g.feature) : groups).filter((g) => g.links.length);
const links = visible.reduce((n, g) => n + g.links.length, 0);
const open = visible.filter((g) => g.feature);
const more = compact ? [] : visible.filter((g) => !g.feature);
const hasPage = visible.some((g) => g.links.some((l) => l.kind === 'page'));
const verb = (l: ShopLink) => (l.kind === 'product' ? 'See on Amazon' : l.kind === 'search' ? 'Search on Amazon' : l.label);
---
{links > 0 && (
<aside class="buy shop" id={anchor ? 'shop' : undefined} aria-label="Amazon links">
  <div class="buy-head">{compact ? 'See it on Amazon' : title}</div>
  <div class="buy-body">
    <p class="shop-disclosure"><strong>{AMAZON_DISCLOSURE}</strong> <span class="muted">{hasPage ? 'Amazon links are labeled See or Search on Amazon. “Look up your chain” stays on this site. ' : 'These are Amazon links. '}<a href="/affiliate-disclosure/">How that works</a>.</span></p>
    {!compact && <p class="small">{lead ?? 'Verify pitch, gauge and drive links against your bar stamp before buying — a listing title is not proof of fit.'}{flagged && ' Setups marked “conflict” or “verify” in the table have no spec-matched link here: read your stamp first.'}</p>}
    {open.map((g) => (
      <div>
        {!compact && <h3 class="shop-h">{g.title}</h3>}
        {g.allButtons ? (
          g.links.map((l) => <a class:list={['shop-btn', l.kind === 'page' && 'shop-btn-page']} href={l.href} target={l.kind === 'page' ? undefined : AFFILIATE_TARGET} rel={l.kind === 'page' ? undefined : AFFILIATE_REL}><span class="shop-btn-verb">{verb(l)}</span>{l.kind !== 'page' && <span class="shop-btn-spec">{l.label}</span>}</a>)
        ) : (
          <>
            <a class:list={['shop-btn', g.links[0].kind === 'page' && 'shop-btn-page']} href={g.links[0].href} target={g.links[0].kind === 'page' ? undefined : AFFILIATE_TARGET} rel={g.links[0].kind === 'page' ? undefined : AFFILIATE_REL}><span class="shop-btn-verb">{verb(g.links[0])}</span>{g.links[0].kind !== 'page' && <span class="shop-btn-spec">{g.links[0].label}</span>}</a>
            {g.links.length > 1 && (
              <ul class="shop-list">
                {g.links.slice(1).map((l) => (
                  <li><a href={l.href} target={l.kind === 'page' ? undefined : AFFILIATE_TARGET} rel={l.kind === 'page' ? undefined : AFFILIATE_REL}>{l.kind === 'page' ? l.label : `${verb(l)} — ${l.label}`}</a>{l.note && <span class="shop-kind">{l.note}</span>}</li>
                ))}
              </ul>
            )}
          </>
        )}
      </div>
    ))}
    {more.length > 0 && (
      <details class="shop-more">
        <summary>Also on Amazon</summary>
        {more.map((g) => (
          <div>
            <h3 class="shop-h">{g.title}</h3>
            <ul class="shop-list">
              {g.links.map((l) => (
                <li><a href={l.href} target={l.kind === 'page' ? undefined : AFFILIATE_TARGET} rel={l.kind === 'page' ? undefined : AFFILIATE_REL}>{l.kind === 'page' ? l.label : `${verb(l)} — ${l.label}`}</a>{l.note && <span class="shop-kind">{l.note}</span>}</li>
              ))}
            </ul>
          </div>
        ))}
      </details>
    )}
  </div>
</aside>
)}

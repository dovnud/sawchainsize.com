---
const N = 30;
---
<div class="hero-saw">
              <svg id="sawStage" viewBox="0 42 1200 172" width="1200" height="172" role="img" aria-label="Animated chainsaw with its chain running around the guide bar, entering from the left">
                <defs>
                  <path id="chainPath" d="M470 96 H1108 A34 34 0 0 1 1108 164 H470 A34 34 0 0 1 470 96 Z" />
                  <linearGradient id="og" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#f07a24"/><stop offset=".55" stop-color="#e05e0b"/><stop offset="1" stop-color="#c24a06"/>
                  </linearGradient>
                  <linearGradient id="steel" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#d7dbe0"/><stop offset=".5" stop-color="#aeb4bc"/><stop offset="1" stop-color="#8f959d"/>
                  </linearGradient>
                  <linearGradient id="darkg" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#3c3f44"/><stop offset="1" stop-color="#222428"/>
                  </linearGradient>
                </defs>
                <g id="sawGroup">
                  <g transform="rotate(-2 600 130)">
                    <g class="saw-vibe">
                      <!-- guide bar -->
                      <path d="M478 104 H1100 A26 26 0 0 1 1100 156 H478 A26 26 0 0 1 478 104 Z" fill="url(#steel)" stroke="#5c6167" stroke-width="1.5"/>
                      <text x="700" y="138" font-family="IBM Plex Mono, monospace" font-size="16" letter-spacing="3" fill="#5f646b">20&Prime; &middot; .050&Prime; GAUGE</text>
                      <circle cx="1072" cy="130" r="4.5" fill="#5c6167"/>
                      <!-- running chain -->
                      {Array.from({ length: N }, (_, i) => <rect x="-6.5" y="-4" width="13" height="8" rx="2" fill="#e8590c" stroke="#7a2d04" stroke-width=".6"><animateMotion dur="1.6s" begin={`-${(i * 1.6 / N).toFixed(3)}s`} repeatCount="indefinite" rotate="auto"><mpath href="#chainPath" /></animateMotion></rect>)}
                      <!-- bumper spikes -->
                      <path d="M448 108 l26 8 -26 8 Z" fill="#6d7278"/>
                      <path d="M448 140 l26 8 -26 8 Z" fill="#6d7278"/>
                      <!-- muffler -->
                      <rect x="336" y="128" width="62" height="42" rx="7" fill="url(#darkg)"/>
                      <line x1="346" y1="140" x2="388" y2="140" stroke="#101114" stroke-width="3"/>
                      <line x1="346" y1="150" x2="388" y2="150" stroke="#101114" stroke-width="3"/>
                      <line x1="346" y1="160" x2="388" y2="160" stroke="#101114" stroke-width="3"/>
                      <!-- main body (powerhead), rear sticks off the left edge -->
                      <path d="M-28 84 a26 26 0 0 1 26 -26 h300 a34 34 0 0 1 34 34 v44 a34 34 0 0 1 -34 34 H28 a28 28 0 0 1 -28 -28 V110 a26 26 0 0 1 -28 -26 Z" fill="url(#og)" stroke="#9c3c05" stroke-width="2"/>
                      <!-- engine shroud -->
                      <path d="M60 58 h190 a20 20 0 0 1 20 20 v10 H44 v-12 a18 18 0 0 1 16 -18 Z" fill="#f58a35" opacity=".85"/>
                      <line x1="70" y1="70" x2="240" y2="70" stroke="#c24a06" stroke-width="3" stroke-linecap="round"/>
                      <line x1="70" y1="79" x2="220" y2="79" stroke="#c24a06" stroke-width="3" stroke-linecap="round"/>
                      <!-- starter cover -->
                      <circle cx="128" cy="122" r="36" fill="url(#darkg)" stroke="#101114" stroke-width="2"/>
                      <circle cx="128" cy="122" r="27" fill="none" stroke="#54575c" stroke-width="2"/>
                      <circle cx="128" cy="122" r="7" fill="#54575c"/>
                      <circle cx="128" cy="99" r="3" fill="#54575c"/><circle cx="151" cy="122" r="3" fill="#54575c"/><circle cx="128" cy="145" r="3" fill="#54575c"/><circle cx="105" cy="122" r="3" fill="#54575c"/>
                      <!-- air filter cover + caps -->
                      <rect x="196" y="96" width="86" height="52" rx="10" fill="#d65408" stroke="#9c3c05" stroke-width="2"/>
                      <circle cx="252" cy="76" r="11" fill="url(#darkg)"/><path d="M245 76 h14 M252 69 v14" stroke="#54575c" stroke-width="2.5"/>
                      <text x="212" y="130" fill="#fff" font-family="IBM Plex Mono, monospace" font-size="17" font-weight="600" letter-spacing="1">455</text>
                      <!-- rear handle with trigger -->
                      <path d="M286 52 h96 a16 16 0 0 1 16 16 v8 h-26 v-8 a8 8 0 0 0 -8 -8 h-78 Z" fill="url(#darkg)"/>
                      <rect x="330" y="76" width="26" height="10" rx="4" fill="#e8590c"/>
                      <!-- chain brake guard -->
                      <path d="M318 92 l44 -14 6 14 -42 16 Z" fill="#2c2e32"/>
                      <!-- front wrap handle -->
                      <path d="M52 96 C6 84 -2 138 16 182" fill="none" stroke="#222428" stroke-width="15" stroke-linecap="round"/>
                      <path d="M52 96 C6 84 -2 138 16 182" fill="none" stroke="#3c3f44" stroke-width="6" stroke-linecap="round" opacity=".7"/>
                    </g>
                  </g>
                </g>
                <circle class="puff p1" cx="410" cy="170" r="6"/>
                <circle class="puff p2" cx="418" cy="174" r="8"/>
                <circle class="puff p3" cx="404" cy="164" r="5"/>
              </svg>

  <div class="rpm" role="group" aria-label="Throttle">
    <button type="button" class="rpm-btn" data-dur="3.4" data-vibe=".55s" aria-pressed="false">IDLE</button>
    <button type="button" class="rpm-btn" data-dur="1.6" data-vibe=".28s" aria-pressed="true">WORKING</button>
    <button type="button" class="rpm-btn" data-dur="0.75" data-vibe=".15s" aria-pressed="false">FULL THROTTLE</button>
    <span class="rpm-read" id="rpmRead">LOOP 1.6 s &middot; WORKING</span>
  </div>
</div>

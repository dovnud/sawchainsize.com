---
const { faqs, html = false } = Astro.props as { faqs: { q: string; a: string }[]; html?: boolean };
---
<div style="margin-top:16px">
  {faqs.map((f) => (
    <details class="faq">
      <summary>{f.q}</summary>
      <div class="a">{html ? <p set:html={f.a} /> : <p>{f.a}</p>}</div>
    </details>
  ))}
</div>

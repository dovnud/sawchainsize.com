---
import { type Model, hasConflict } from '../lib/data';
const { model } = Astro.props as { model: Model };
import ShopBlock from './ShopBlock.astro';
import { modelShop } from '../lib/shop';
const shop = modelShop(model);
const okBars = model.data.bars.filter((b) => b.status === 'ok');
---
<div class="buy">
  <div class="buy-head">Where to buy the right loop</div>
  <div class="buy-body">
    {okBars.length ? (
      <p>Match pitch, gauge and drive links to the table above (OEM and equivalent part numbers are listed per bar). Oregon publishes full specs at <a href="https://www.oregonproducts.com" target="_blank" rel="noopener">oregonproducts.com</a>.</p>
    ) : (
      <p>{hasConflict(model) ? 'Because published specs conflict for this saw' : 'Because no source we could read confirms a drive-link count for this saw'}, we do not point you at a specific loop for it. Read the three numbers off your bar stamp, then search any retailer below by pitch + gauge + drive links (for example “.325 .050 72”).</p>
    )}
    <p class="small muted" style="margin-top:10px">We show no prices: they change daily and the checkout price is the real one.</p>
  </div>
</div>
<ShopBlock groups={shop.groups} flagged={shop.flagged} />

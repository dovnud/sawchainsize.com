---
const { crumbs = [] } = Astro.props as { crumbs: { name: string; path?: string }[] };
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    {crumbs.map((c, i) => <li>{c.path && i < crumbs.length - 1 ? <a href={c.path}>{c.name}</a> : <span aria-current={i === crumbs.length - 1 ? 'page' : undefined}>{c.name}</span>}</li>)}
  </ol>
</nav>

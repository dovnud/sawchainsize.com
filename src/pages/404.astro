---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="That page does not exist. Use the chain finder to look up your saw." path="/404/" noindex={true}>
  <div class="wrap">
    <div class="pagehead">
      <h1>Page not found</h1>
      <p class="lede">That page does not exist or has moved. Try the <a href="/">chain finder</a>, browse <a href="/saws/">all saw models</a> or the <a href="/guides/">guides</a>.</p>
    </div>
  </div>
</Base>

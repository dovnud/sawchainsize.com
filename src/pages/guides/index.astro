---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { SITE } from '../../lib/data';
import { webPageLd } from '../../lib/ld';
const guides = [
  { href: '/guides/how-to-verify-chain-size/', t: 'How to verify your chain size', d: 'Three checks — bar stamp, drive-link count, pitch and gauge measurement — with worked examples.' },
  { href: '/guides/chain-size-chart/', t: 'Chain identification chart', d: 'Pitch × gauge × file size, plus the Oregon / Stihl / Husqvarna / Carlton code cross-reference.' },
  { href: '/guides/how-to-count-drive-links/', t: 'How to count drive links', d: 'Mark one link, count the tangs under the loop, match the number on the box.' },
  { href: '/guides/oregon-72-vs-73-chain/', t: 'Oregon 72 vs 73 chain', d: 'Same 3/8″ pitch, different gauge — the classic wrong buy and how to avoid it.' },
  { href: '/guides/chainsaw-chain-file-size/', t: 'Chainsaw chain file size', d: 'Which round file sharpens which pitch.' },
  { href: '/guides/chainsaw-sharpening-angles/', t: 'Chainsaw sharpening angles', d: 'Top-plate angle, down angle and depth-gauge setting for each Oregon chain type.' },
  { href: '/guides/chain-part-numbers/', t: 'Chainsaw chain part numbers, decoded', d: 'What STIHL 33 RS3 84, Husqvarna S93G and Echo 91PX52CQ say about pitch, gauge and drive links.' },
  { href: '/guides/longer-bar-on-chainsaw/', t: 'Can you put a longer bar on your chainsaw?', d: 'The four checks, plus the shortest and longest bar listed for every saw we cover.' },
  { href: '/how-we-verify/', t: 'How we verify specs', d: 'Our source hierarchy and how conflicts are shown.' },
];
const desc = 'Chainsaw chain guides: verify your chain size, read the identification chart, count drive links, Oregon 72 vs 73, file size, sharpening angles, fitting a longer bar and decoding chain part numbers.';
---
<Base title="Chainsaw Chain Guides" description={desc} path="/guides/" nav="verify" crumbs={[{ name: 'Guides', path: '/guides/' }]}
  jsonld={[webPageLd('Chainsaw chain guides', '/guides/', desc, SITE.dataDate, 'CollectionPage')]} modified={SITE.dataDate}>
  <div class="wrap">
    <div class="pagehead">
      <Crumbs crumbs={[{ name: 'Guides' }]} />
      <h1>Chainsaw chain guides</h1>
      <p class="lede">Plain-English guides for getting the chain size right the first time.</p>
    </div>
    <div class="grid2">{guides.map((g) => <a class="card" href={g.href}><h2>{g.t}</h2><p class="small">{g.d}</p><span class="go">Read →</span></a>)}</div>
  </div>
</Base>

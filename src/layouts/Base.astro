---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieNote from '../components/CookieNote.astro';
import { SITE, ldEscape } from '../lib/data';
import { pageGraph } from '../lib/ld';
import { isoDate, metaDescription, serpTitle } from '../lib/seo';
import pageDates from '../data/page-dates.json';
import { GA4_ID, GA_OPTOUT_COOKIE } from '../config/analytics';

export interface Props {
  title: string;
  description: string;
  path: string; // canonical path, always with leading + trailing slash
  og?: string; // path to a 1200x630 png under /og/
  ogAlt?: string;
  type?: 'website' | 'article';
  nav?: string;
  crumbs?: { name: string; path: string }[]; // excludes Home
  jsonld?: Record<string, unknown>[];
  modified?: string; // ISO date
  noindex?: boolean;
}
import { existsSync } from 'node:fs';
const pageOg = '/og/page-' + Astro.props.path.replace(/^\/|\/$/g, '').replace(/\//g, '-') + '.png';
const { title, description, path, og = existsSync('./public' + pageOg) ? pageOg : SITE.defaultOg, ogAlt, type = 'website', nav = '', crumbs = [], jsonld = [], modified, noindex = false } = Astro.props;
const canonical = SITE.url + path;
const ogUrl = SITE.url + og;
const fullTitle = serpTitle(title);
const metaDesc = metaDescription(description);
const dated = (pageDates as Record<string, string>)[path] ?? modified;
const modifiedIso = isoDate(dated);
// Minimal inline stub; gtag.js itself is injected late (first interaction, or after load + idle) and never if opted out.
const gaSnippet = GA4_ID ? `(function(){var id=${JSON.stringify(GA4_ID)};
if(document.cookie.indexOf(${JSON.stringify(GA_OPTOUT_COOKIE + '=0')})>-1){window['ga-disable-'+id]=true;return;}
window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}window.gtag=gtag;
gtag('js',new Date());gtag('config',id,{allow_google_signals:false,allow_ad_personalization_signals:false});
var done=false;function load(){if(done)return;done=true;
['pointerdown','keydown','scroll','touchstart'].forEach(function(e){removeEventListener(e,load);});
var s=document.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id='+id;document.head.appendChild(s);}
['pointerdown','keydown','scroll','touchstart'].forEach(function(e){addEventListener(e,load,{once:true,passive:true});});
function later(){if('requestIdleCallback' in window)requestIdleCallback(load,{timeout:4000});else setTimeout(load,4000);}
if(document.readyState==='complete')later();else addEventListener('load',later);
})();` : '';
const graph = pageGraph({
  title: fullTitle,
  description: metaDesc,
  path,
  modified: modifiedIso,
  crumbs,
  extra: jsonld,
});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#232a30" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDesc} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="preload" href="/fonts/barlow-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/barlow-condensed-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt ?? `${SITE.name} — ${SITE.tagline}`} />
    {modifiedIso && <meta property="article:modified_time" content={modifiedIso} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={ogAlt ?? `${SITE.name} — ${SITE.tagline}`} />
    <script type="application/ld+json" set:html={ldEscape(graph)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div id="scrollProgress" aria-hidden="true"></div>
    <Header active={nav} />
    <main id="main">
      <article>
        <slot />
      </article>
    </main>
    <Footer />
    <CookieNote />
    {gaSnippet && <script is:inline set:html={gaSnippet} />}
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>

{
  // Pages project sawchainsize-site. D1 binding DB -> sawchainsize-subscribers.
  // TURNSTILE_SECRET is a Pages secret on that project and is not stored here.
  "name": "sawchainsize-site",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-24",
  "vars": {
    "NODE_VERSION": "22"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sawchainsize-subscribers",
      "database_id": "4933bd5b-7d40-4eb9-b1a7-db5b1e148f6d",
      "migrations_dir": "migrations"
    }
  ]
}
